{
  "name": "Mort’s Finanzas",
  "short_name": "Mort’s",
  "description": "Las finanzas de Facu y Marti",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#2a9bf0",
  "theme_color": "#1a8fe8",
  "lang": "es-AR",
  "icons": [
    { "src": "img/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{ "name": "archivos", "accept": ["image/*", "audio/*", ".opus", ".ogg", ".m4a", ".mp3"] }]
    }
  }
}
